{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "Backend/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/api/index.py"
    },
    {
      "src": "/docs(.*)",
      "dest": "Backend/api/index.py"
    },
    {
      "src": "/redoc(.*)",
      "dest": "Backend/api/index.py"
    },
    {
      "src": "/openapi.json(.*)",
      "dest": "Backend/api/index.py"
    },
    {
      "src": "/health",
      "dest": "Backend/api/index.py"
    },
    {
      "src": "/version",
      "dest": "Backend/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
